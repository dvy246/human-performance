---
import "@/styles/global.css"
import SyncPanel from "@/components/ui/SyncPanel"
import ThemeToggle from "@/components/ui/ThemeToggle"
import CalibrationBanner from "@/components/ui/CalibrationBanner"
import OnboardingFlow from "@/components/ui/OnboardingFlow"
import HowToPlayModal from "@/components/ui/HowToPlayModal"
import { KeyboardShortcutsHelp } from "@/components/ui/KeyboardShortcuts"
import RecentTests from "@/components/ui/RecentTests"
import Icon from "@/components/ui/Icon.astro"
import LanguageSwitcher from "@/components/ui/LanguageSwitcher"
import GameSearch from "@/components/ui/GameSearch"
import { translations, t, type LangCode } from "@/i18n/translations"
import FaqsList from "@/components/ui/FaqsList.astro"
import { getFaqSchemaForSlug, hasFaqsForPath } from "@/data/faqs"

interface Props {
  title?: string
  description?: string
  canonicalUrl?: string
  ogImage?: string
  ogType?: "website" | "article" | string
  schemaJson?: Record<string, any> | Record<string, any>[]
  robots?: string
  lang?: LangCode
}

const {
  title = "CogniArena — Free Reaction Time Test & Cognitive Assessments",
  description = "Take the free reaction time test and measure your reflexes in milliseconds. 29+ cognitive assessments including IQ test, typing test, memory games. 100% anonymous, runs in your browser.",
  canonicalUrl = "https://cogniarena.com",
  ogImage,
  ogType,
  schemaJson,
  robots = "index, follow",
  lang,
} = Astro.props

const { pathname } = Astro.url

// Determine active language
const pathLocaleMatch = pathname.match(/^\/(es|fr|de|pt|ja)(\/|$)/)
const currentLang: LangCode = lang || (pathLocaleMatch ? (pathLocaleMatch[1] as LangCode) : "en")
const localePrefix = currentLang === "en" ? "" : `/${currentLang}`

// Clean unlocalized path for hreflang cluster and canonical resolution
const cleanPath = pathname.replace(/^\/(es|fr|de|pt|ja)(\/|$)/, "/")
const unlocalizedPath = cleanPath.startsWith("/") ? cleanPath : `/${cleanPath}`

const ogLocaleMap: Record<LangCode, string> = {
  en: "en_US",
  es: "es_ES",
  fr: "fr_FR",
  de: "de_DE",
  pt: "pt_BR",
  ja: "ja_JP",
}

// Normalize canonicalUrl to ensure it ends with a trailing slash
let formattedCanonicalUrl = canonicalUrl;
if (formattedCanonicalUrl) {
  if (formattedCanonicalUrl === "https://cogniarena.com" || formattedCanonicalUrl === "https://cogniarena.com/") {
    formattedCanonicalUrl = currentLang === "en" ? "https://cogniarena.com/" : `https://cogniarena.com/${currentLang}/`;
  } else if (!formattedCanonicalUrl.endsWith('/')) {
    const lastPart = formattedCanonicalUrl.split('/').pop() || '';
    if (!lastPart.includes('.')) {
      formattedCanonicalUrl = formattedCanonicalUrl + '/';
    }
  }
}

// Resolve fully-qualified absolute OG image URL (PNG format for broad social crawler compatibility)
let resolvedOgImage = "https://cogniarena.com/og-image.png";
if (ogImage) {
  if (ogImage.startsWith("http://") || ogImage.startsWith("https://")) {
    resolvedOgImage = ogImage;
  } else {
    resolvedOgImage = `https://cogniarena.com${ogImage.startsWith("/") ? "" : "/"}${ogImage}`;
  }
}

// Resolve OG type (articles for educational / learn guides, website for everything else)
const resolvedOgType = ogType || (pathname.startsWith("/learn/") && pathname !== "/learn" && pathname !== "/learn/" ? "article" : "website");


// Organization + WebSite schema — injected on every page for knowledge panel / sitelinks
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://cogniarena.com/#organization",
  name: "CogniArena",
  url: "https://cogniarena.com/",
  logo: {
    "@type": "ImageObject",
    url: "https://cogniarena.com/og-image.png",
    width: "1200",
    height: "630",
  },
  description:
    "Free online cognitive assessment platform with 29+ brain tests measuring reaction time, memory, reasoning, focus, and motor skills.",
  foundingDate: "2025",
}

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://cogniarena.com/#website",
  name: "CogniArena",
  url: "https://cogniarena.com/",
  description:
    "Free online cognitive assessments, reflex testers, and brain training platform.",
  inLanguage: currentLang,
  publisher: {
    "@id": "https://cogniarena.com/#organization",
  },
}

// Default structured data for the site (fallback when page provides no schema)
const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description: description,
  url: formattedCanonicalUrl,
  publisher: {
    "@type": "Organization",
    name: "CogniArena",
    url: "https://cogniarena.com/",
  },
}

// Build final schema array: page schemas + global org/webSite schemas
const pageSchemas = Array.isArray(schemaJson)
  ? [...schemaJson]
  : [schemaJson || defaultSchema]

const isHome = pathname.replace(/\/$/, "") === "" || pathname.includes("/index.html")

// Parse slug
let testSlug = ""
if (unlocalizedPath === "/gauntlet" || unlocalizedPath === "/gauntlet/") {
  testSlug = "gauntlet"
} else if (unlocalizedPath === "/attention-test" || unlocalizedPath === "/attention-test/") {
  testSlug = "attention-test"
} else if (unlocalizedPath.startsWith("/tests/")) {
  const parts = unlocalizedPath.split("/").filter(Boolean)
  if (parts[1] && parts[1] !== "results") {
    testSlug = parts[1]
  }
}

// Append FAQ schema if available
if (testSlug && hasFaqsForPath(testSlug)) {
  pageSchemas.push(getFaqSchemaForSlug(testSlug))
}

const finalSchemas = [...pageSchemas, orgSchema, webSiteSchema]

// Determine active state indicators
const isReactionOpen =
  pathname.includes("/tests/reaction-time") ||
  pathname.includes("/tests/f1-lights") ||
  pathname.includes("/tests/sound-reaction") ||
  pathname.includes("/tests/choice-reaction") ||
  pathname.includes("/tests/go-no-go")
const isMemoryOpen =
  pathname.includes("/tests/sequence-memory") ||
  pathname.includes("/tests/number-memory") ||
  pathname.includes("/tests/visual-pattern") ||
  pathname.includes("/tests/dual-n-back") ||
  pathname.includes("/tests/verbal-memory")
const isReasoningOpen =
  pathname.includes("/tests/pattern-reasoning") ||
  pathname.includes("/tests/spatial-orientation")
const isFocusOpen =
  pathname.includes("/tests/stroop") ||
  pathname.includes("/tests/trail-making") ||
  pathname.includes("/tests/focus-challenge") ||
  pathname.includes("/attention-test") ||
  pathname.includes("/color-game") ||
  pathname.includes("/gauntlet")
const isMotorOpen =
  pathname.includes("/tests/click-speed") ||
  pathname.includes("/tests/aim-trainer") ||
  pathname.includes("/tests/mouse-accuracy") ||
  pathname.includes("/tests/flick-trainer") ||
  pathname.includes("/tests/typing-speed") ||
  pathname.includes("/tests/aim-coordination")
const isExecutiveOpen =
  pathname.includes("/tests/trail-making") ||
  pathname.includes("/tests/decision-speed") ||
  pathname.includes("/tests/planning") ||
  pathname.includes("/tests/prioritization") // Keep default closed unless clicked
const isScienceOpen = pathname.includes("/learn/")
const isHomeActive = pathname === "/"
const isTestsActive = pathname.startsWith("/tests")
const isHistoryActive = pathname === "/history"
const isProfileActive = pathname === "/dashboard"
---

<html lang={currentLang}>
  <head>
    <script is:inline>
      const stored = localStorage.getItem("theme")
      const systemDark = window.matchMedia(
        "(prefers-color-scheme: dark)"
      ).matches
      const theme = stored || (systemDark ? "dark" : "light")
      if (theme === "dark") {
        document.documentElement.classList.add("dark")
      } else {
        document.documentElement.classList.remove("dark")
      }
    </script>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=5.0"
    />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="cogniarena" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={formattedCanonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={`https://cogniarena.com${unlocalizedPath === "/" ? "/" : unlocalizedPath}`} />
    <link rel="alternate" hreflang="en" href={`https://cogniarena.com${unlocalizedPath === "/" ? "/" : unlocalizedPath}`} />
    <link rel="alternate" hreflang="es" href={`https://cogniarena.com/es${unlocalizedPath === "/" ? "/" : unlocalizedPath}`} />
    <link rel="alternate" hreflang="fr" href={`https://cogniarena.com/fr${unlocalizedPath === "/" ? "/" : unlocalizedPath}`} />
    <link rel="alternate" hreflang="de" href={`https://cogniarena.com/de${unlocalizedPath === "/" ? "/" : unlocalizedPath}`} />
    <link rel="alternate" hreflang="pt" href={`https://cogniarena.com/pt${unlocalizedPath === "/" ? "/" : unlocalizedPath}`} />
    <link rel="alternate" hreflang="ja" href={`https://cogniarena.com/ja${unlocalizedPath === "/" ? "/" : unlocalizedPath}`} />
    <title>{title}</title>

    <!-- Meta tags for SEO -->
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="yandex-verification" content="2cae89c2d02f63bb" />

    <!-- Open Graph tags for Social Sharing -->
    <meta property="og:locale" content={ogLocaleMap[currentLang] || "en_US"} />
    <meta property="og:locale:alternate" content="es_ES" />
    <meta property="og:locale:alternate" content="fr_FR" />
    <meta property="og:locale:alternate" content="de_DE" />
    <meta property="og:locale:alternate" content="pt_BR" />
    <meta property="og:locale:alternate" content="ja_JP" />

    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={formattedCanonicalUrl} />
    <meta property="og:site_name" content="CogniArena" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta
      property="og:image:type"
      content={resolvedOgImage.endsWith(".jpg") || resolvedOgImage.endsWith(".jpeg")
        ? "image/jpeg"
        : "image/png"}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter card tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Theme Color -->
    <meta
      name="theme-color"
      content="#000000"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#f8fafc"
      media="(prefers-color-scheme: light)"
    />

    <!-- JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(finalSchemas[0])}
    />
    {
      finalSchemas.length > 1 &&
        finalSchemas
          .slice(1)
          .map((s: any) => (
            <script type="application/ld+json" set:html={JSON.stringify(s)} />
          ))
    }

    <!-- Preconnect + Web Fonts (instead of CSS @import for performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    <!-- i18n: Embed translations data + load translation engine -->
    <script
      is:inline
      set:html={`window.__i18nData = ${JSON.stringify(translations)};`}
    />
    <script is:inline src="/i18n.js"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9WHJWEWD5L"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag("js", new Date())
      gtag("config", "G-9WHJWEWD5L")
    </script>

    <!-- Google AdSense -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5910777021067126"
      crossorigin="anonymous"></script>
  </head>
  <body
    class="flex min-h-screen flex-col bg-background text-foreground antialiased"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
      >Skip to content</a
    >

    <!-- Onboarding Flow -->
    <OnboardingFlow client:idle />

    <!-- How To Play Modal (Test Onboarding) -->
    <HowToPlayModal client:idle />

    <!-- Keyboard Shortcuts Help Modal -->
    <KeyboardShortcutsHelp client:idle />
    <div class="flex min-h-screen flex-1 flex-col lg:flex-row">
      <!-- Desktop Sidebar Layout -->
      <aside
        class="hidden w-64 shrink-0 flex-col gap-8 border-r border-card-border bg-card p-6 lg:flex"
      >
        <div class="flex flex-col gap-2">
          <a
            href={`${localePrefix}/`}
            class="flex items-center gap-2 transition-opacity hover:opacity-90"
          >
            <img
              src="/favicon.svg"
              alt="CogniArena"
              width="32"
              height="32"
              class="h-8 w-8"
            />
            <span class="text-lg font-bold tracking-tight text-foreground"
              >CogniArena</span
            >
          </a>
          <span
            class="px-1 text-[10px] tracking-widest text-muted uppercase"
            data-i18n="nav.tagline">Discover Your Cognitive Potential</span
          >
        </div>

        <nav class="flex flex-1 flex-col gap-3.5 overflow-y-auto pr-1">
          <!-- Ecosystem -->
          <div class="flex flex-col gap-1">
            <span
              class="mb-1 px-2 font-mono text-[10px] font-semibold tracking-widest text-muted uppercase"
              data-i18n="nav.ecosystem">Ecosystem</span
            >
            <a
              href={`${localePrefix}/`}
              class={`flex items-center gap-2.5 px-3 py-2 rounded-md text-xs transition-standard hover:bg-subtle ${pathname === "/" ? "bg-accent/15 border-l-2 border-accent text-accent font-semibold" : "text-muted hover:text-foreground"}`}
            >
              <Icon name="home" size={16} />
              <span data-i18n="nav.home">{t("nav.home", currentLang, "Home Overview")}</span>
            </a>
            <a
              href={`${localePrefix}/benchmarks/`}
              class={`flex items-center gap-2.5 px-3 py-2 rounded-md text-xs transition-standard hover:bg-subtle ${pathname.includes("/benchmarks") ? "bg-accent/15 border-l-2 border-accent text-accent font-semibold" : "text-muted hover:text-foreground"}`}
            >
              <Icon name="chart-bar" size={16} />
              <span data-i18n="nav.benchmarks">{t("nav.benchmarks", currentLang, "Population Benchmarks")}</span>
            </a>
            <a
              href={`${localePrefix}/dashboard/`}
              class={`flex items-center gap-2.5 px-3 py-2 rounded-md text-xs transition-standard hover:bg-subtle ${pathname.includes("/dashboard") ? "bg-accent/15 border-l-2 border-accent text-accent font-semibold" : "text-muted hover:text-foreground"}`}
            >
              <Icon name="chart-bar" size={16} />
              <span data-i18n="nav.dashboard">{t("nav.dashboard", currentLang, "Dashboard")}</span>
            </a>
            <a
              href={`${localePrefix}/records/`}
              class={`flex items-center gap-2.5 px-3 py-2 rounded-md text-xs transition-standard hover:bg-subtle ${pathname === "/records" ? "bg-accent/15 border-l-2 border-accent text-accent font-semibold" : "text-muted hover:text-foreground"}`}
            >
              <Icon name="clipboard" size={16} />
              <span data-i18n="nav.records">{t("nav.records", currentLang, "Personal Records")}</span>
            </a>
            <a
              href={`${localePrefix}/brain-games/`}
              class={`flex items-center gap-2.5 px-3 py-2 rounded-md text-xs transition-standard hover:bg-subtle ${pathname === "/brain-games" ? "bg-accent/15 border-l-2 border-accent text-accent font-semibold" : "text-muted hover:text-foreground"}`}
            >
              <Icon name="brain" size={16} />
              <span data-i18n="nav.brain_games">{t("nav.brain_games", currentLang, "Brain Games")}</span>
            </a>
            <a
              href={`${localePrefix}/gauntlet/`}
              class={`flex items-center gap-2.5 px-3 py-2 rounded-md text-xs transition-standard hover:bg-subtle ${pathname.includes("/gauntlet") ? "bg-accent/15 border-l-2 border-accent text-accent font-semibold" : "text-muted hover:text-foreground"}`}
            >
              <Icon name="castle" size={16} />
              <span data-i18n="nav.gauntlet">{t("nav.gauntlet", currentLang, "The Gauntlet")}</span>
              <span
                class="ml-auto font-mono text-[8px] text-accent uppercase"
                data-i18n="nav.flagship">Flagship</span
              >
            </a>
          </div>

          <!-- Reaction & Reflexes Accordion -->
          <details class="group" open={isReactionOpen}>
            <summary
              class="flex cursor-pointer list-none items-center justify-between rounded-md px-2 py-1.5 font-mono text-[10px] font-semibold tracking-widest text-muted uppercase select-none hover:text-foreground [&::-webkit-details-marker]:hidden"
            >
              <div class="flex items-center gap-1.5">
                <Icon name="zap" size={16} />
                <span data-i18n="nav.reaction">{t("nav.reaction", currentLang, "Reaction & Reflexes")}</span>
              </div>
              <svg
                class="h-3 w-3 text-muted transition-transform duration-250 group-open:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div
              class="mt-1 flex flex-col gap-1 border-l border-card-border/60 pl-2"
            >
              <a
                href={`${localePrefix}/tests/reaction-time/`}
                class={`flex items-center gap-2 px-3 py-1.5 rounded text-xs transition-standard hover:bg-subtle ${pathname.includes("/tests/reaction-time") ? "text-accent font-semibold bg-accent/5" : "text-muted hover:text-foreground"}`}
              >
                <Icon name="zap" size={16} />
                <span data-i18n="nav.visual_reaction">{t("nav.visual_reaction", currentLang, "Visual Reaction")}</span>
              </a>
              <a
                href={`${localePrefix}/tests/sound-reaction/`}
                class={`flex items-center gap-2 px-3 py-1.5 rounded text-xs transition-standard hover:bg-subtle ${pathname.includes("/tests/sound-reaction") ? "text-accent font-semibold bg-accent/5" : "text-muted hover:text-foreground"}`}
              >
                <Icon name="volume" size={16} />
                <span data-i18n="nav.auditory_reflex">{t("nav.auditory_reflex", currentLang, "Auditory Reflex")}</span>
              </a>
              <a
                href={`${localePrefix}/tests/f1-lights/`}
                class={`flex items-center gap-2 px-3 py-1.5 rounded text-xs transition-standard hover:bg-subtle ${pathname.includes("/tests/f1-lights") ? "text-accent font-semibold bg-accent/5" : "text-muted hover:text-foreground"}`}
              >
                <Icon name="flag" size={16} />
                <span data-i18n="nav.f1_lights">{t("nav.f1_lights", currentLang, "F1 Start Lights")}</span>
              </a>
              <a
                href={`${localePrefix}/tests/choice-reaction/`}
                class={`flex items-center gap-2 px-3 py-1.5 rounded text-xs transition-standard hover:bg-subtle ${pathname.includes("/tests/choice-reaction") ? "text-accent font-semibold bg-accent/5" : "text-muted hover:text-foreground"}`}
              >
                <Icon name="hash" size={16} />
                <span data-i18n="nav.choice_reaction">{t("nav.choice_reaction", currentLang, "Choice Reaction")}</span>
              </a>
              <a
                href={`${localePrefix}/tests/go-no-go/`}
                class={`flex items-center gap-2 px-3 py-1.5 rounded text-xs transition-standard hover:bg-subtle ${pathname.includes("/tests/go-no-go") ? "text-accent font-semibold bg-accent/5" : "text-muted hover:text-foreground"}`}
              >
                <Icon name="shield" size={16} />
                <span data-i18n="nav.go_nogo">{t("nav.go_nogo", currentLang, "Color Go/No-Go")}</span>
              </a>
              <a
                href={`${localePrefix}/tests/latency-optimizer/`}
                class={`flex items-center gap-2 px-3 py-1.5 rounded text-xs transition-standard hover:bg-subtle ${pathname.includes("/tests/latency-optimizer") ? "text-accent font-semibold bg-accent/5" : "text-muted hover:text-foreground"}`}
              >
                <Icon name="zap" size={16} />
                <span data-i18n="nav.latency_optimizer">{t("nav.latency_optimizer", currentLang, "Latency & Hz Optimizer")}</span>
              </a>
            </div>
          </details>

          <!-- Memory Accordion -->
          <details class="group" open={isMemoryOpen}>
            <summary
              class="flex cursor-pointer list-none items-center justify-between rounded-md px-2 py-1.5 font-mono text-[10px] font-semibold tracking-widest text-muted uppercase select-none hover:text-foreground [&::-webkit-details-marker]:hidden"
            >
              <div class="flex items-center gap-1.5">
                <Icon name="brain" size={16} />
                <span data-i18n="nav.memory">{t("nav.memory", currentLang, "Memory")}</span>
              </div>
              <svg
                class="h-3 w-3 text-muted transition-transform duration-250 group-open:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div
              class="mt-1 flex flex-col gap-1 border-l border-card-border/60 pl-2"
            >
              <a
                href={`${localePrefix}/tests/sequence-memory/`}
                class={`flex items-center gap-2 px-3 py-1.5 rounded text-xs transition-standard hover:bg-subtle ${pathname.includes("/tests/sequence-memory") ? "text-accent font-semibold bg-accent/5" : "text-muted hover:text-foreground"}`}
              >
                <Icon name="layers" size={16} />
                <span data-i18n="nav.sequence_memory">{t("nav.sequence_memory", currentLang, "Sequence Memory")}</span>
              </a>
              <a
                href={`${localePrefix}/tests/number-memory/`}
                class={`flex items-center gap-2 px-3 py-1.5 rounded text-xs transition-standard hover:bg-subtle ${pathname.includes("/tests/number-memory") ? "text-accent font-semibold bg-accent/5" : "text-muted hover:text-foreground"}`}
              >
                <Icon name="hash" size={16} />
                <span data-i18n="nav.number_memory">{t("nav.number_memory", currentLang, "Number Memory")}</span>
              </a>
