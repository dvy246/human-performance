---
import Layout from "@/layouts/main.astro"
import LogicTest from "@/components/quiz/LogicTest"

const title = "Free Logic Benchmark Online — Measure Your Logic Instantly | CogniArena"
const description =
  "Take a free online logic benchmark and get your score instantly. 20 questions covering logical, numerical, and spatial reasoning with percentile rankings."
const canonicalUrl = "https://cogniarena.com/quiz/iq-test"

const schemaJson = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    name: "CogniArena Free Logic Benchmark",
    description:
      "A 20-question logic benchmark covering numerical, verbal, spatial, and logical reasoning domains, inspired by the ICAR problem-solving skill framework.",
    about: { "@type": "Thing", name: "Logic and Puzzle Solving" },
    educationalAlignment: {
      "@type": "AlignmentObject",
      alignmentType: "educationalRequirement",
      educationalFramework: "Cognitive Science",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What does an logic benchmark measure?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "An logic benchmark measures cognitive abilities including logical reasoning, pattern recognition, working memory, processing speed, verbal comprehension, and spatial reasoning. logic scores follow a normal distribution with a mean of 100 and standard deviation of 15.",
        },
      },
      {
        "@type": "Question",
        name: "Is this logic benchmark free?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. CogniArena's logic benchmark is completely free. No sign-up, no payment, and no data collection. You get instant results with a score estimate and percentile ranking.",
        },
      },
      {
        "@type": "Question",
        name: "How accurate is this online logic benchmark?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "This logic benchmark uses question formats inspired by the ICAR framework, which correlates with established measures like Raven's Progressive Matrices. However, it is a 20-question estimate and not a substitute for a professionally administered cognitive evaluation.",
        },
      },
      {
        "@type": "Question",
        name: "What is a good logic score?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "logic scores follow a bell curve: 85-115 is average (68% of people), 115-130 is above average, and 130+ is considered gifted. The average Logic is 100 by definition.",
        },
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://cogniarena.com",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Quizzes",
        item: "https://cogniarena.com/quiz",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Logic Benchmark",
        item: "https://cogniarena.com/quiz/iq-test",
      },
    ],
  },
]
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schemaJson={schemaJson}
>
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-6">
    <header class="flex flex-col gap-3">
      <div
        class="flex items-center gap-2 font-mono text-xs tracking-widest text-accent uppercase"
      >
        <span>Quizzes</span>
        <span>&middot;</span>
        <span>Cognitive Reasoning Quiz</span>
      </div>
      <h1
        class="text-3xl font-extrabold tracking-tight text-foreground md:text-4xl"
      >
        Free Logic Benchmark: Measure Your problem-solving ability Online
      </h1>
      <p class="max-w-2xl text-sm leading-relaxed text-muted md:text-base">
        Take this free online logic benchmark and get your score instantly. 20 questions
        across logical, numerical, verbal, and spatial reasoning — no sign-up
        required.
      </p>
    </header>
    <section class="w-full"><LogicTest client:visible /></section>

    <!-- Frequently Asked Questions (Matches FAQPage Schema) -->
    <section class="mt-4 flex flex-col gap-4 border-t border-card-border/40 pt-6">
      <h2 class="text-xl font-bold tracking-tight text-foreground">
        Frequently Asked Questions
      </h2>
      <div class="flex flex-col gap-3">
        <details
          class="group card-interactive rounded-xl border border-card-border bg-card p-4"
        >
          <summary
            class="flex cursor-pointer items-center justify-between text-sm font-semibold text-foreground"
          >
            What does an logic benchmark measure?
            <svg
              class="h-4 w-4 text-muted transition-transform group-open:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            An logic benchmark measures cognitive abilities including logical reasoning,
            pattern recognition, working memory, processing speed, verbal
            comprehension, and spatial reasoning. logic scores follow a normal
            distribution with a mean of 100 and standard deviation of 15.
          </p>
        </details>
        <details
          class="group card-interactive rounded-xl border border-card-border bg-card p-4"
        >
          <summary
            class="flex cursor-pointer items-center justify-between text-sm font-semibold text-foreground"
          >
            Is this logic benchmark free?
            <svg
              class="h-4 w-4 text-muted transition-transform group-open:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Yes. CogniArena's logic benchmark is completely free. No sign-up, no payment,
            and no data collection. You get instant results with a score estimate
            and percentile ranking.
          </p>
        </details>
        <details
          class="group card-interactive rounded-xl border border-card-border bg-card p-4"
        >
          <summary
            class="flex cursor-pointer items-center justify-between text-sm font-semibold text-foreground"
          >
            How accurate is this online logic benchmark?
            <svg
              class="h-4 w-4 text-muted transition-transform group-open:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            This logic benchmark uses question formats inspired by the ICAR framework,
            which correlates with established measures like Raven's Progressive
            Matrices. However, it is a 20-question estimate and not a substitute
            for a professionally administered cognitive evaluation.
          </p>
        </details>
        <details
          class="group card-interactive rounded-xl border border-card-border bg-card p-4"
        >
          <summary
            class="flex cursor-pointer items-center justify-between text-sm font-semibold text-foreground"
          >
            What is a good logic score?
            <svg
              class="h-4 w-4 text-muted transition-transform group-open:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            logic scores follow a bell curve: 85-115 is average (68% of people),
            115-130 is above average, and 130+ is considered gifted. The average
            Logic is 100 by definition.
          </p>
        </details>
      </div>
    </section>

    <div
      class="rounded-xl border border-card-border bg-subtle p-4 text-xs leading-relaxed text-muted shadow-sm"
    >
      <strong class="font-semibold text-foreground"
        >Entertainment Disclaimer:</strong
      > This quiz is for entertainment and self-educational purposes only. It is not
      a clinically validated Logic assessment, nor a clinical or diagnostic evaluation.
      Scores are estimates based on a 20-question sample and should not be treated
      as a professionally administered cognitive evaluation. For a comprehensive assessment,
      consult a licensed psychologist.
    </div>
  </div>
</Layout>
