---
import Layout from "@/layouts/main.astro"
import { nonDefaultLocales, t, type LangCode } from "@/i18n/translations"

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({
    params: { lang },
  }))
}

const { lang } = Astro.params as { lang: LangCode }
const localePrefix = `/${lang}`
const canonicalUrl = `https://cogniarena.com/${lang}/compare/human-benchmark-alternative`
const title = "Human Benchmark Alternative — CogniArena vs Human Benchmark"
const description = "Compare CogniArena and Human Benchmark: timing calibration, 29+ cognitive tests, 100% anonymous local-first privacy, and comprehensive scientific guides."

const schemaJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Human Benchmark Alternative: CogniArena Feature & Accuracy Comparison",
    description: description,
    url: canonicalUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: t("mobile.home", lang, "Home"),
        item: `https://cogniarena.com/${lang}`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Compare",
        item: canonicalUrl,
      },
    ],
  },
]
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schemaJson={schemaJson}
  lang={lang}
>
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-12">
    <header class="flex flex-col gap-3">
      <nav
        class="flex items-center gap-2 font-mono text-xs tracking-widest text-accent uppercase"
        aria-label="Breadcrumb"
      >
        <a href={`${localePrefix}/`} class="hover:underline">{t("mobile.home", lang, "Home")}</a>
        <span>/</span>
        <span class="text-muted">Comparison</span>
      </nav>
      <h1
        class="text-3xl font-extrabold tracking-tight text-foreground md:text-4xl"
      >
        CogniArena vs Human Benchmark
      </h1>
      <p class="max-w-2xl text-sm leading-relaxed text-muted md:text-base">
        {description}
      </p>
    </header>

    <section class="flex flex-col gap-6 border-t border-card-border pt-8">
      <a
        href={`${localePrefix}/gauntlet`}
        class="flex items-center justify-between rounded-xl border border-accent/30 bg-accent/10 p-5 transition-colors hover:bg-accent/20"
      >
        <div class="flex flex-col gap-1">
          <h2 class="text-base font-bold text-foreground">
            {t("nav.gauntlet", lang, "Try The Gauntlet")}
          </h2>
          <p class="text-xs text-muted">
            5-stage composite cognitive assessment benchmark.
          </p>
        </div>
        <span class="rounded bg-accent px-4 py-2 text-xs font-bold text-white">Start →</span>
      </a>
    </section>
  </div>
</Layout>
