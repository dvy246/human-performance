---
import Layout from "@/layouts/main.astro"
import { nonDefaultLocales, t, type LangCode } from "@/i18n/translations"

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({
    params: { lang },
  }))
}

const { lang } = Astro.params as { lang: LangCode }
const localePrefix = `/${lang}`
const canonicalUrl = `https://cogniarena.com/${lang}/learn`
const title = `${t("learning.title", lang, "Learning Center")} | CogniArena`
const description = t("learning.guide_desc", lang, "Explore 20+ cognitive science guides covering reaction time, memory, executive function, and focus.")

const schemaJson = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "CogniArena Learning Center",
  description: description,
  provider: {
    "@type": "Organization",
    name: "CogniArena",
    url: "https://cogniarena.com",
  },
  about: {
    "@type": "Thing",
    name: "Cognitive Science",
  },
}

const categories = [
  {
    name: "Reflex & Motor Skills",
    icon: "⚡",
    guides: [
      {
        href: `${localePrefix}/learn/reaction-time/`,
        icon: "🧠",
        title: "Reaction Time Science",
        desc: "Visual and auditory reflex pathways, Hick's Law, and paint-sync calibration protocols.",
      },
      {
        href: `${localePrefix}/learn/click-speed/`,
        icon: "🖱️",
        title: "Click Speed Science",
        desc: "Neuromuscular firing rates, clicking biomechanics, jitter vs butterfly techniques.",
      },
      {
        href: `${localePrefix}/learn/aim-training/`,
        icon: "🎯",
        title: "Aim Training Science",
        desc: "Fitts's Law, spatial motor mapping, flick vs tracking precision, and mouse sensitivity.",
      },
      {
        href: `${localePrefix}/learn/choice-reaction/`,
        icon: "⚡",
        title: "Choice Reaction Time",
        desc: "Hick-Hyman Law, Donders subtraction method, and multi-alternative decision latency.",
      },
      {
        href: `${localePrefix}/learn/f1-lights/`,
        icon: "🏎️",
        title: "Peripheral Vision",
        desc: "Retinal rod density, peripheral motion detection, and athletic start reaction training.",
      },
      {
        href: `${localePrefix}/learn/flick-trainer/`,
        icon: "🎯",
        title: "Visual Tracking",
        desc: "Smooth pursuit vs saccadic eye movements, dynamic visual acuity, and target acquisition.",
      },
      {
        href: `${localePrefix}/learn/mouse-accuracy/`,
        icon: "🎯",
        title: "Fine Motor Control",
        desc: "Motor unit recruitment, deceleration control, and precision target acquisition.",
      },
      {
        href: `${localePrefix}/learn/sound-reaction/`,
        icon: "🔊",
        title: "Auditory Processing",
        desc: "Cochlear transduction, auditory brainstem responses, and audio vs visual reaction times.",
      },
    ],
  },
  {
    name: "Memory & Processing",
    icon: "🧠",
    guides: [
      {
        href: `${localePrefix}/learn/memory-test/`,
        icon: "🧠",
        title: "Memory Science",
        desc: "Working memory architecture, Miller's 7±2 law, cognitive load theory, and chunking.",
      },
      {
        href: `${localePrefix}/learn/dual-n-back/`,
        icon: "🔄",
        title: "Dual N-Back Training",
        desc: "Jaeggi protocol, working memory updating, fluid intelligence transfer, and brain training.",
      },
      {
        href: `${localePrefix}/learn/number-memory/`,
        icon: "🔢",
        title: "Number Memory",
        desc: "Phonological loop, digit span capacity, major system mnemonics, and working memory.",
      },
      {
        href: `${localePrefix}/learn/sequence-memory/`,
        icon: "🧩",
        title: "Sequence Memory",
        desc: "Visuospatial sketchpad, Corsi block-tapping task, spatial chunking, and memory span.",
      },
      {
        href: `${localePrefix}/learn/verbal-memory/`,
        icon: "📝",
        title: "Verbal Recall",
        desc: "Episodic vs semantic memory, word frequency effects, false memory paradigms.",
      },
      {
        href: `${localePrefix}/learn/visual-pattern/`,
        icon: "👁️",
        title: "Visual Pattern Recognition",
        desc: "Gestalt grouping principles, visual working memory capacity, and pattern completion.",
      },
    ],
  },
  {
    name: "Executive & Cognitive Control",
    icon: "🧩",
    guides: [
      {
        href: `${localePrefix}/learn/brain-training/`,
        icon: "🧠",
        title: "Cognitive Training Science",
        desc: "Neuroplasticity mechanisms, near vs far transfer effects, and evidence-based training.",
      },
      {
        href: `${localePrefix}/learn/planning/`,
        icon: "📐",
        title: "Executive Planning",
        desc: "Tower of London/Hanoi paradigms, dorsolateral prefrontal cortex, look-ahead depth.",
      },
      {
        href: `${localePrefix}/learn/prioritization/`,
        icon: "⚖️",
        title: "Task Prioritization",
        desc: "Eisenhower matrix neuroscience, cognitive triage, urgency vs importance trade-offs.",
      },
      {
        href: `${localePrefix}/learn/stroop/`,
        icon: "🎨",
        title: "Stroop Effect",
        desc: "Automated reading vs color processing, anterior cingulate cortex, selective attention.",
      },
      {
        href: `${localePrefix}/learn/trail-making/`,
        icon: "🔀",
        title: "Cognitive Set Shifting",
        desc: "Trail Making Test Parts A & B, executive function, task-switching costs.",
      },
      {
        href: `${localePrefix}/learn/spatial-orientation/`,
        icon: "🧭",
        title: "Mental Rotation",
        desc: "Shepard-Metzler mental rotation, parietal lobe spatial processing, 3D visualization.",
      },
      {
        href: `${localePrefix}/learn/decision-speed/`,
        icon: "⚡",
        title: "Processing Speed",
        desc: "Mental chronometry, inspection time, information processing rate, and cognitive efficiency.",
      },
      {
        href: `${localePrefix}/learn/iq-test/`,
        icon: "📊",
        title: "IQ & Intelligence Testing",
        desc: "g factor, Cattell-Horn-Carroll theory, Raven's matrices, fluid vs crystallized intelligence.",
      },
      {
        href: `${localePrefix}/learn/typing-speed/`,
        icon: "⌨️",
        title: "Typing Ergonomics & Speed",
        desc: "Motor chunking, predictive finger motion, touch-typing muscle memory, and WPM limits.",
      },
    ],
  },
]
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schemaJson={schemaJson}
  lang={lang}
>
  <div class="mx-auto flex w-full max-w-4xl flex-col gap-12">
    <header class="flex flex-col gap-4">
      <div
        class="flex items-center gap-2 font-mono text-xs tracking-widest text-accent uppercase"
      >
        <span>{t("learning.title", lang, "Learning Center")}</span>
        <span>&middot;</span>
        <span>{t("learning.view_all", lang, "All Guides")}</span>
      </div>
      <h1
        class="animate-fade-in text-3xl font-extrabold tracking-tight text-foreground md:text-4xl"
      >
        {t("learning.title", lang, "Cognitive Science & Performance Guides")}
      </h1>
      <p
        class="max-w-3xl text-sm leading-relaxed text-muted md:text-base"
      >
        {description}
      </p>
    </header>

    <div class="flex flex-col gap-10">
      {
        categories.map((cat) => (
          <section class="flex flex-col gap-4">
            <h2 class="flex items-center gap-2 text-lg font-bold text-foreground">
              <span>{cat.icon}</span>
              <span>{cat.name}</span>
            </h2>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {cat.guides.map((g) => (
                <a
                  href={g.href}
                  class="card-interactive group flex flex-col justify-between rounded-xl border border-card-border bg-card p-4 transition-all hover:border-accent/50 hover:bg-subtle"
                >
                  <div class="flex flex-col gap-2">
                    <div class="flex items-center justify-between">
                      <span class="text-xl">{g.icon}</span>
                      <span class="font-mono text-[10px] text-accent group-hover:underline">
                        Read Guide &rarr;
                      </span>
                    </div>
                    <h3 class="text-sm font-bold text-foreground group-hover:text-accent">
                      {g.title}
                    </h3>
                    <p class="text-xs leading-relaxed text-muted">{g.desc}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Layout>
