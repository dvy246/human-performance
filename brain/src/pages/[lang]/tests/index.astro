---
import Layout from "@/layouts/main.astro"
import ExploreTests from "@/components/ui/ExploreTests.astro"
import { nonDefaultLocales, t, type LangCode } from "@/i18n/translations"

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({
    params: { lang },
  }))
}

const { lang } = Astro.params as { lang: LangCode }
const localePrefix = `/${lang}`
const canonicalUrl = `https://cogniarena.com/${lang}/tests`
const title = `${t("mobile.tests", lang, "Tests")} | CogniArena`
const description = t("hero.subtitle", lang, "Explore our complete library of 24+ free brain tests, cognitive assessments, and online mind power games.")

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: t("mobile.home", lang, "Home"),
      item: `https://cogniarena.com/${lang}`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t("mobile.tests", lang, "Tests"),
      item: canonicalUrl,
    },
  ],
}

const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Cognitive Assessments Collection",
  description: description,
  url: canonicalUrl,
}

const schemaJson = [breadcrumbSchema, collectionPageSchema]
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schemaJson={schemaJson}
  lang={lang}
>
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-10 py-4">
    <!-- Header Section -->
    <header class="flex flex-col gap-3">
      <div
        class="flex items-center gap-2 font-mono text-xs tracking-widest text-accent uppercase"
      >
        <span>CogniArena</span>
        <span>&middot;</span>
        <span>{t("mobile.tests", lang, "Assessments")}</span>
      </div>
      <h1
        class="text-3xl font-extrabold tracking-tight text-foreground md:text-4xl"
      >
        {t("explore.title", lang, "Cognitive Assessments Library")}
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-muted md:text-base">
        {description}
      </p>
    </header>

    <!-- Explore all tests -->
    <ExploreTests lang={lang} />
  </div>
</Layout>
