---
import Layout from "@/layouts/main.astro"
import TestResultsPage from "@/components/ui/TestResultsPage"
import { nonDefaultLocales, t, type LangCode } from "@/i18n/translations"

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({
    params: { lang },
  }))
}

const { lang } = Astro.params as { lang: LangCode }
const canonicalUrl = `https://cogniarena.com/${lang}/tests/results`
---

<Layout
  title="Test Results — CogniArena"
  description="View your detailed cognitive test results."
  canonicalUrl={canonicalUrl}
  robots="noindex, nofollow"
  lang={lang}
>
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-8">
    <TestResultsPage client:load lang={lang} />
  </div>
</Layout>
