---
import Layout from "@/layouts/main.astro"
import { nonDefaultLocales, t, type LangCode } from "@/i18n/translations"

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({
    params: { lang },
  }))
}

const { lang } = Astro.params as { lang: LangCode }
const canonicalUrl = `https://cogniarena.com/${lang}/methodology`
const title = `${t("meth.title", lang, "Scientific Methodology & Calibration Protocols")} | CogniArena`
const description = t("meth.subtitle", lang, "Explore the neural science and technical formulas behind CogniArena, including Hick's Law, Fitts's Law, Miller's Law, and high-precision browser timers.")

const schemaJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description: description,
    url: canonicalUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: t("mobile.home", lang, "Home"),
        item: `https://cogniarena.com/${lang}`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: t("footer.methodology", lang, "Methodology"),
        item: canonicalUrl,
      },
    ],
  },
]
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schemaJson={schemaJson}
  lang={lang}
>
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-12">
    <!-- Header Section -->
    <header class="flex flex-col gap-3">
      <div
        class="flex items-center gap-2 font-mono text-xs tracking-widest text-accent uppercase"
      >
        <span data-i18n="meth.badge1">{t("meth.badge1", lang, "Scientific Foundation")}</span>
        <span>&middot;</span>
        <span data-i18n="meth.badge2">{t("meth.badge2", lang, "Calibration Specs")}</span>
      </div>
      <h1
        class="animate-fade-in text-3xl font-extrabold tracking-tight text-foreground md:text-4xl"
        data-i18n="meth.title"
      >
        {t("meth.title", lang, "Technical & Scientific Methodology")}
      </h1>
      <p
        class="text-sm leading-relaxed text-muted md:text-base dark:text-muted"
        data-i18n="meth.subtitle"
      >
        {t("meth.subtitle", lang, "CogniArena is engineered to eliminate browser rendering discrepancies and quantify cognitive-motor functions using established neuro-computational models.")}
      </p>
    </header>

    <!-- Methodology Content Grid -->
    <section class="flex flex-col gap-12 border-t border-card-border pt-10">
      <!-- 1. Millisecond-Accurate Paint Sync -->
      <article class="flex flex-col gap-4">
        <h2
          class="flex items-center gap-2 text-xl font-bold tracking-tight text-foreground"
        >
          <span class="font-mono text-sm text-accent">01.</span>
          Millisecond-Accurate Paint Sync Calibration
        </h2>
        <p
          class="text-sm leading-relaxed text-muted dark:text-muted"
          data-i18n="meth.s1_p1"
        >
          {t("meth.s1_p1", lang, "Standard browser reaction timers initiate time-captions during a state trigger, letting the browser queue and paint the visual state change asynchronously. This introduces a variable latency jitter of 8ms to 32ms depending on GPU scheduling and screen refresh rates.")}
        </p>
        <p
          class="text-sm leading-relaxed text-muted dark:text-muted"
          data-i18n="meth.s1_p2"
        >
          {t("meth.s1_p2", lang, "CogniArena resolves this by measuring reaction triggers using a double-nested requestAnimationFrame (rAF) loop. The start timestamp is locked only when the browser confirms the paint buffer has updated, matching real-world photon emission delays.")}
        </p>
        <div
          class="rounded-lg border border-card-border bg-subtle p-4 font-mono text-xs text-foreground/80"
        >
          <span class="text-muted">// Visual trigger paint synchronization</span><br />
          requestAnimationFrame(() =&gt; &#123;<br />
          &nbsp;&nbsp;requestAnimationFrame(() =&gt; &#123;<br />
          &nbsp;&nbsp;&nbsp;&nbsp;startTime.current = performance.now();<br />
          &nbsp;&nbsp;&#125;);<br />
          &#125;);
        </div>
      </article>

      <!-- 2. Hick's Law -->
      <article class="flex flex-col gap-4">
        <h2
          class="flex items-center gap-2 text-xl font-bold tracking-tight text-foreground"
        >
          <span class="font-mono text-sm text-accent">02.</span>
          Hick's Law (Choice &amp; Decision Latency)
        </h2>
        <p
          class="text-sm leading-relaxed text-muted dark:text-muted"
          data-i18n="meth.s2_p1"
        >
          {t("meth.s2_p1", lang, "Hick's Law states that the time it takes to make a decision increases logarithmically with the number of alternatives:")}
        </p>
        <div
          class="rounded-lg border border-card-border bg-subtle px-5 py-3 text-center font-mono text-base text-accent"
        >
          RT = a + b &middot; log₂ (n)
        </div>
        <p
          class="text-sm leading-relaxed text-muted dark:text-muted"
          data-i18n="meth.s2_p2"
        >
          {t("meth.s2_p2", lang, "In our Choice Reaction Test, n = 4. This logarithmic increase represents prefrontal cortex stimulus-classification delays. We calibrate this by subtracting the participant's simple reaction time base to measure pure decision-overhead.")}
        </p>
      </article>

      <!-- 3. Fitts's Law -->
      <article class="flex flex-col gap-4">
        <h2
          class="flex items-center gap-2 text-xl font-bold tracking-tight text-foreground"
        >
          <span class="font-mono text-sm text-accent">03.</span>
          Fitts's Law (Spatial Aim Precision)
        </h2>
        <p
          class="text-sm leading-relaxed text-muted dark:text-muted"
          data-i18n="meth.s3_p1"
        >
          {t("meth.s3_p1", lang, "Fitts's Law predicts that the time required to rapidly move to a target is a function of the ratio between the distance to the target and the width of the target:")}
        </p>
        <div
          class="rounded-lg border border-card-border bg-subtle px-5 py-3 text-center font-mono text-base text-accent"
        >
          MT = a + b &middot; log₂ (2D / W)
        </div>
        <p
          class="text-sm leading-relaxed text-muted dark:text-muted"
          data-i18n="meth.s3_p2"
        >
          {t("meth.s3_p2", lang, "Our Aim Precision Trainer logs pinpoint coordinate offsets (sub-pixel distances from target center) and target acquire latency. This indexes the efficiency of the motor-cortex feedback loops governing spatial control.")}
        </p>
      </article>

      <!-- 4. Web Audio API Auditory Low-Latency -->
      <article class="flex flex-col gap-4">
        <h2
          class="flex items-center gap-2 text-xl font-bold tracking-tight text-foreground"
        >
          <span class="font-mono text-sm text-accent">04.</span>
          Auditory Low-Latency Web Audio API
        </h2>
        <p
          class="text-sm leading-relaxed text-muted dark:text-muted"
          data-i18n="meth.s4_p1"
        >
          {t("meth.s4_p1", lang, "Playing compressed audio formats like .mp3 or .wav via HTML5 <audio> elements triggers decoder setup overhead and buffer delay.")}
        </p>
        <p
          class="text-sm leading-relaxed text-muted dark:text-muted"
          data-i18n="meth.s4_p2"
        >
          {t("meth.s4_p2", lang, "Our Sound Reflex Test synthesizes a pure 750Hz sine tone directly on the audio hardware thread using the Web Audio API OscillatorNode. This minimizes audio emission delay to sub-millisecond ranges.")}
        </p>
      </article>

      <!-- 5. Miller's Law -->
      <article class="flex flex-col gap-4">
        <h2
          class="flex items-center gap-2 text-xl font-bold tracking-tight text-foreground"
        >
          <span class="font-mono text-sm text-accent">05.</span>
          Miller's Law (Working Memory)
        </h2>
        <p
          class="text-sm leading-relaxed text-muted dark:text-muted"
          data-i18n="meth.s5_p1"
        >
          {t("meth.s5_p1", lang, "Miller's Law states that the average human short-term working memory span can hold approximately 7 items or \"chunks\" (7 ± 2).")}
        </p>
        <p
          class="text-sm leading-relaxed text-muted dark:text-muted"
          data-i18n="meth.s5_p2"
        >
          {t("meth.s5_p2", lang, "The Sequence Memory Test evaluates this boundary. By chunking coordinate lists into visual shapes, patterns, or vectors, participants can bypass Miller's Law limits and reach higher levels.")}
        </p>
      </article>
    </section>
  </div>
</Layout>
