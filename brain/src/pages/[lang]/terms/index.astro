---
import Layout from "@/layouts/main.astro"
import { nonDefaultLocales, t, type LangCode } from "@/i18n/translations"

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({
    params: { lang },
  }))
}

const { lang } = Astro.params as { lang: LangCode }
const canonicalUrl = `https://cogniarena.com/${lang}/terms`
const title = `${t("terms.title", lang, "Terms of Service")} | CogniArena`
const description = t("terms.subtitle", lang, "CogniArena Terms of Service. Understand local ledger limitations and non-medical assessment disclaimers.")

const schemaJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description: description,
    url: canonicalUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: t("mobile.home", lang, "Home"),
        item: `https://cogniarena.com/${lang}`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: t("footer.terms", lang, "Terms of Service"),
        item: canonicalUrl,
      },
    ],
  },
]
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schemaJson={schemaJson}
  lang={lang}
>
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-10 py-4">
    <header class="flex flex-col gap-3">
      <span
        class="font-mono text-xs tracking-widest text-accent uppercase"
        data-i18n="terms.badge">{t("terms.badge", lang, "Legal Documentation")}</span
      >
      <h1
        class="text-3xl font-extrabold tracking-tight text-foreground md:text-4xl"
        data-i18n="terms.title"
      >
        {t("terms.title", lang, "Terms of Service")}
      </h1>
      <p
        class="text-sm leading-relaxed text-muted md:text-base dark:text-muted"
        data-i18n="terms.subtitle"
      >
        {t("terms.subtitle", lang, "Effective date: July 5, 2026.")}
      </p>
    </header>

    <section
      class="flex flex-col gap-8 border-t border-card-border pt-10 text-sm leading-relaxed text-muted dark:text-muted"
    >
      <article class="flex flex-col gap-3">
        <h2
          class="text-lg font-bold text-foreground"
          data-i18n="terms.s1_title"
        >
          {t("terms.s1_title", lang, "1. Service Utilization & Limits")}
        </h2>
        <p data-i18n="terms.s1_desc">
          {t("terms.s1_desc", lang, "CogniArena is provided for self-assessment, cognitive training, and general performance logging purposes only. The assessments are not medical, diagnostic, or clinical evaluations and should not be used as such.")}
        </p>
      </article>

      <article class="flex flex-col gap-3">
        <h2
          class="text-lg font-bold text-foreground"
          data-i18n="terms.s2_title"
        >
          {t("terms.s2_title", lang, "2. Disclaimer of Warranties")}
        </h2>
        <p data-i18n="terms.s2_desc">
          {t("terms.s2_desc", lang, "We do not warrant that our telemetry scores are free from hardware delay distortions (such as touchscreen interface processing delays, GPU paint syncing latency, or operating system interrupts).")}
        </p>
      </article>

      <article class="flex flex-col gap-3">
        <h2
          class="text-lg font-bold text-foreground"
          data-i18n="terms.s3_title"
        >
          {t("terms.s3_title", lang, "3. Fair Use & Bot Protocols")}
        </h2>
        <p data-i18n="terms.s3_desc">
          {t("terms.s3_desc", lang, "Attempts to automate grid inputs, visual paint clicks, or coordinate target acquisition using scripted macro tools or background headless instances is strictly prohibited. We reserve the right to flag anomalies in local scores to preserve leaderboard integrity.")}
        </p>
      </article>
    </section>
  </div>
</Layout>
